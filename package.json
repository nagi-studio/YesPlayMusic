{
  "name": "yesplaymusic",
  "version": "0.11.1",
  "private": true,
  "description": "A third party music player for Netease Music",
  "author": "Nagi Studio (fork of qier222/YesPlayMusic)",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build:renderer": "vite build",
    "typecheck": "bun run typecheck:renderer && bun run typecheck:sidecar && bun run typecheck:test",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:sidecar": "tsc --noEmit -p tsconfig.sidecar.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "dev:tauri:renderer": "IS_TAURI=true vite",
    "build:tauri:renderer": "IS_TAURI=true vite build && bun scripts/build-app-compliance.mjs",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "bun scripts/build-tauri-host.mjs",
    "build:tauri:macos": "tauri build --target aarch64-apple-darwin && bun run sign:tauri:local",
    "build:tauri:macos:updater": "bun scripts/build-tauri-updater.mjs darwin-aarch64",
    "build:tauri:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --ci",
    "build:tauri:windows:updater": "bun scripts/build-tauri-updater.mjs windows-x86_64",
    "build:tauri:linux": "tauri build --verbose --target x86_64-unknown-linux-gnu --bundles deb,appimage --ci",
    "build:tauri:linux:updater": "bun scripts/build-tauri-updater.mjs linux-x86_64",
    "build:tauri:release": "bun scripts/build-tauri-updater.mjs darwin-aarch64 --developer-id",
    "sign:tauri:local": "bun scripts/sign-tauri-local.mjs",
    "package:tauri:dmg": "bun scripts/package-tauri-dmg.mjs",
    "collect:tauri:release-dmg": "bun scripts/package-tauri-dmg.mjs --collect-release",
    "verify:tauri:release-env": "bun scripts/verify-apple-release-env.mjs",
    "verify:tauri:updater-env": "bun scripts/verify-updater-release-env.mjs",
    "verify:tauri:version": "bun scripts/verify-tauri-version.mjs",
    "smoke:tauri": "bun scripts/smoke-tauri-local.mjs",
    "smoke:tauri:core": "bun scripts/smoke-tauri-local.mjs --core-only",
    "smoke:tauri:supervisor": "bun scripts/smoke-tauri-supervisor.mjs",
    "build:sidecar": "bun scripts/build-rust-sidecar.mjs --release && bun scripts/build-sidecar-compliance.mjs",
    "build:sidecar:dev": "bun scripts/build-rust-sidecar.mjs --debug && bun scripts/build-sidecar-compliance.mjs --notices-only",
    "build:sidecar:bun-reference": "bun scripts/build-sidecar.mjs",
    "build:ypm:compliance": "bun scripts/build-ypm-compliance.mjs",
    "test": "bun test",
    "prettier": "npx prettier --write ./src",
    "netease_api:run": "npx @neteaseapireborn/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neteaseapireborn/api": "^4.29.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@unblockneteasemusic/rust-napi": "^0.4.0",
    "axios": "^0.26.1",
    "change-case": "^4.1.2",
    "cli-color": "^2.0.0",
    "color": "^4.2.3",
    "crypto-js": "^4.0.0",
    "dayjs": "^1.8.36",
    "dexie": "^3.0.3",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "express-http-proxy": "^1.6.2",
    "howler": "^2.2.3",
    "js-cookie": "^2.2.1",
    "jsbi": "^4.1.0",
    "lodash": "^4.17.20",
    "md5": "^2.3.0",
    "music-metadata": "^7.5.3",
    "node-vibrant": "^3.2.1-alpha.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "plyr": "^3.6.2",
    "qrcode": "^1.4.4",
    "vscode-codicons": "^0.0.17",
    "vue": "^3",
    "vue-i18n": "^11",
    "vue-router": "^4",
    "vue-slider-component": "^4.1.0-beta.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/cli-color": "^2.0.6",
    "@types/color": "^4.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "4",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-http-proxy": "^1.6.7",
    "@types/howler": "^2.2.13",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "20",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6",
    "@vue/compiler-sfc": "^3",
    "@vue/tsconfig": "^0.9.1",
    "fast-glob": "^3.3.3",
    "prettier": "2.8.8",
    "sass": "^1.26.11",
    "typescript": "6.0.3",
    "vite": "^7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.9"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "packageManager": "bun@1.3.12"
}
