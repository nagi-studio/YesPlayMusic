{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YesPlayMusic",
  "version": "0.11.1",
  "identifier": "com.electron.yesplaymusic",
  "mainBinaryName": "yesplaymusic-tauri",
  "build": {
    "beforeDevCommand": "bun run build:sidecar:dev && bun run dev:tauri:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun scripts/prepare-tauri-build.mjs",
    "frontendDist": "http://127.0.0.1:28232"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; form-action 'self'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/nagi-studio/YesPlayMusic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "category": "Music",
    "externalBin": ["binaries/yesplaymusic-sidecar"],
    "resources": {
      "../dist-tauri/": "renderer/",
      "generated/app-compliance/": "app-compliance/",
      "generated/sidecar-compliance/": "sidecar-compliance/",
      "tauri.conf.json": "updater-artifact-version.json"
    },
    "icon": [
      "../build/icons/32x32.png",
      "../build/icons/128x128.png",
      "../build/icons/256x256.png",
      "../build/icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
